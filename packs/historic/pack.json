{
  "id": "historic",
  "label": "Historic engravings & paintings",
  "shareable": true,
  "description": "Public-domain and CC0 portraits from museum and library collections (engravings, Renaissance and Baroque paintings).",
  "licenses": [
    "public domain",
    "pd",
    "cc0",
    "cc-zero"
  ],
  "eras": [
    {
      "id": "engraving",
      "label": "Engravings (18th\u201319th c.)",
      "sources": [
        {
          "provider": "met",
          "query": {
            "q": "portrait",
            "medium": "Engraving",
            "dateBegin": 1750,
            "dateEnd": 1900
          },
          "limit": 60
        },
        {
          "provider": "met",
          "query": {
            "q": "woman",
            "medium": "Engraving",
            "dateBegin": 1750,
            "dateEnd": 1900
          },
          "limit": 40
        },
        {
          "provider": "loc",
          "query": {
            "q": "portrait",
            "fa": "subject:engravings",
            "dates": "1750/1900"
          },
          "limit": 100
        },
        {
          "provider": "wikimedia",
          "categories": [
            {
              "name": "Engraved_portraits_of_men",
              "gender": "masc",
              "limit": 100
            },
            {
              "name": "Engraved_portraits_of_women",
              "gender": "femme",
              "limit": 100
            },
            {
              "name": "Engravings_of_women",
              "gender": "femme",
              "limit": 60
            }
          ]
        }
      ]
    },
    {
      "id": "baroque-painting",
      "label": "Renaissance & Baroque paintings",
      "sources": [
        {
          "provider": "met",
          "query": {
            "q": "portrait",
            "departmentId": 11,
            "dateBegin": 1500,
            "dateEnd": 1700
          },
          "limit": 40
        }
      ]
    },
    {
      "id": "early-photo",
      "label": "Early photographs (1840s\u20131920s)",
      "sources": [
        {
          "provider": "met",
          "query": {
            "q": "portrait",
            "departmentId": 19,
            "dateBegin": 1839,
            "dateEnd": 1930
          },
          "limit": 70
        },
        {
          "provider": "met",
          "query": {
            "q": "daguerreotype",
            "departmentId": 19
          },
          "limit": 40
        },
        {
          "provider": "met",
          "query": {
            "q": "tintype",
            "departmentId": 19
          },
          "limit": 20
        },
        {
          "provider": "loc",
          "query": {
            "q": "portrait",
            "fa": "subject:daguerreotypes",
            "dates": "1839/1930"
          },
          "limit": 60
        },
        {
          "provider": "loc",
          "query": {
            "q": "portrait",
            "fa": "subject:tintypes",
            "dates": "1839/1930"
          },
          "limit": 40
        },
        {
          "provider": "wikimedia",
          "delayMs": 3000,
          "categories": [
            {
              "name": "Daguerreotype_portraits",
              "limit": 60
            },
            {
              "name": "19th-century_portrait_photographs_of_men",
              "gender": "masc",
              "limit": 60
            },
            {
              "name": "19th-century_portrait_photographs_of_women",
              "gender": "femme",
              "limit": 60
            },
            {
              "name": "Tintypes",
              "limit": 25
            },
            {
              "name": "Cartes_de_visite",
              "limit": 30
            },
            {
              "name": "Cabinet_cards",
              "limit": 30
            },
            {
              "name": "Ambrotypes",
              "limit": 25
            }
          ]
        }
      ]
    }
  ]
}